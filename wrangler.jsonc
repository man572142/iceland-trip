{
  // Static site hosted on Cloudflare Workers static assets.
  // No build step and no Worker script — `public/` is uploaded and served as-is,
  // so `assets.directory` is the entry-point `wrangler deploy` looks for.
  "name": "iceland-trip",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./public"
  }
}
